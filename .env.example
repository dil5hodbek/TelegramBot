# BotFather bergan YANGI tokenni shu yerga yozing.
BOT_TOKEN=replace_with_new_botfather_token

# Profil rasmini AI orqali tekshirish uchun ixtiyoriy.
OPENAI_API_KEY=
OPENAI_MODERATION_ENABLED=true

# true = admin Ha/Yo'q bilan tasdiqlaydi; false = bot avtomatik qaror qiladi.
DRY_RUN=true

# Qaror chegaralari (0-100+ risk balli)
REVIEW_THRESHOLD=35
DELETE_THRESHOLD=60
BAN_THRESHOLD=85

# Bot hisobot yuboradigan guruh/kanal IDsi. Bo'sh bo'lsa log faqat terminalda.
MOD_LOG_CHAT_ID=

# Vergul bilan ajratilgan Telegram admin user IDlari (ixtiyoriy).
ADMIN_IDS=

# Private admin panel boshqaradigan muhokama guruhi IDsi.
PROTECTED_CHAT_ID=

DATABASE_PATH=data/izoh_posbon.db
PROFILE_CACHE_TTL_SECONDS=3600
PROFILE_PHOTO_LIMIT=5
DUPLICATE_WINDOW_SECONDS=86400
COORDINATED_WINDOW_SECONDS=120
COORDINATED_MIN_USERS=3
DATA_RETENTION_DAYS=90
AI_USER_LIMIT=10
AI_USER_WINDOW_SECONDS=30
AI_GLOBAL_LIMIT=120
AI_GLOBAL_WINDOW_SECONDS=60
